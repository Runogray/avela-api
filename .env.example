# Copy to `.env` (git-ignored). docker compose reads this automatically.

# --- Django ------------------------------------------------------------------
# Generate a strong key for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
# Needed when posting to the admin over https / behind a proxy (comma-separated):
CSRF_TRUSTED_ORIGINS=

# --- Database ----------------------------------------------------------------
# In docker compose the API talks to the `db` service, so this is set to `db`
# in docker-compose.yml. For running Django directly on the host against a local
# Postgres, set DATABASE_URL_HOST=localhost (leave blank to use the sqlite file).
DATABASE_URL_HOST=db
DB_NAME=avela
DB_USER=avela
DB_PASSWORD=avela
DB_PORT=5432

# --- Frontend / CORS ---------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (verification OTP / reset codes) ---------------------------------
# The default (console) backend only PRINTS codes to the server log — nothing
# reaches a real inbox. To actually send codes, use Gmail SMTP below.
#
# Gmail setup: the account needs 2-Step Verification ON, then create an
# "App password" at https://myaccount.google.com/apppasswords (16 chars, no
# spaces). Use that as EMAIL_HOST_PASSWORD — NOT your normal Gmail password.
#
# Uncomment + fill these for real sends (keep this file out of git):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your16charapppassword
# DEFAULT_FROM_EMAIL=Avela <youraddress@gmail.com>

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Avela <no-reply@localhost>
EMAIL_OTP_TTL_MINUTES=10

# --- External gateways (stubs run fine when blank) ---------------------------
# Paystack: when set, the payment webhook verifies the X-Paystack-Signature
# header (HMAC-SHA512 of the raw body). Blank = stub/dev (signature skipped).
PAYSTACK_SECRET_KEY=
# NIN provider, e.g. Dojah (wire into integrations/gateways.py -> DojahVerifier)
KYC_PROVIDER_KEY=
